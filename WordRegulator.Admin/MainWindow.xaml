<Window x:Class="WordRegulator.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordRegulator — Lisans Yönetimi"
        Height="620" Width="820"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E30"/>
            <Setter Property="Foreground" Value="#CCCCEE"/>
            <Setter Property="CaretBrush" Value="#2D7DD2"/>
            <Setter Property="BorderBrush" Value="#3A3A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F0F1C" Offset="0"/>
                <GradientStop Color="#161626" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>    <!-- Başlık çubuğu -->
                <RowDefinition Height="Auto"/>  <!-- Ayarlar paneli -->
                <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                <RowDefinition Height="*"/>     <!-- Liste -->
                <RowDefinition Height="Auto"/>  <!-- Durum çubuğu -->
            </Grid.RowDefinitions>

            <!-- ── Başlık Çubuğu ── -->
            <Border Grid.Row="0" Background="#0A0A16" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="WordRegulator Admin" Foreground="#AAAACC"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                            BorderThickness="0" Foreground="#555577" FontSize="14" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ── Ayarlar Paneli (GitHub Token + Gist URL) ── -->
            <Border Grid.Row="1" Background="#12122A" Padding="18,14" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GITHUB PERSONAL ACCESS TOKEN" Foreground="#4455AA"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" Margin="2,0,0,4"/>
                        <TextBox x:Name="TokenTextBox" Style="{StaticResource ConfigTextBox}"
                                 ToolTip="GitHub → Settings → Developer Settings → Personal Access Tokens → gist scope"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GIST ID" Foreground="#4455AA"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" Margin="2,0,0,4"/>
                        <TextBox x:Name="GistIdTextBox" Style="{StaticResource ConfigTextBox}"
                                 ToolTip="Gist URL'sindeki ID: gist.github.com/username/GIST_ID_BURASI"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Listeleri Yükle" VerticalAlignment="Bottom"
                            Style="{StaticResource ActionBtn}" Background="#2D7DD2" Foreground="White"
                            Click="LoadLicenses_Click"/>
                </Grid>
            </Border>

            <!-- ── Araç Çubuğu ── -->
            <Border Grid.Row="2" Padding="18,10" BorderBrush="#222236" BorderThickness="0,1,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ Yeni Lisans Üret" Style="{StaticResource ActionBtn}"
                                Background="#1A7A4A" Foreground="White" Margin="0,0,8,0"
                                Click="NewLicense_Click"/>
                        <Button Content="⟳ Yenile" Style="{StaticResource ActionBtn}"
                                Background="#2A2A4A" Foreground="#AAAACC"
                                Click="LoadLicenses_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#555577" FontFamily="Segoe UI" FontSize="11"/>
                </Grid>
            </Border>

            <!-- ── Lisans Listesi ── -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0">
                <ItemsControl x:Name="LicenseList" Margin="18,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="16,12" CornerRadius="10"
                                    Background="#1A1A2E">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Active}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Durum indikatörü -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#2ECC71"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Fill" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Bilgiler -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Key}" Foreground="#DDDDFF"
                                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Customer}" Foreground="#8888AA"
                                                       FontFamily="Segoe UI" FontSize="12" Margin="0,0,16,0"/>
                                            <TextBlock Foreground="#555577" FontFamily="Segoe UI" FontSize="12">
                                                <TextBlock.Text>
                                                    <Binding Path="Expires" StringFormat="Bitiş: {0:dd.MM.yyyy}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Kopyala butonu -->
                                    <Button Grid.Column="2" Content="📋 Kopyala"
                                            Style="{StaticResource ActionBtn}"
                                            Background="#2A2A4A" Foreground="#AAAACC"
                                            Margin="0,0,8,0"
                                            Tag="{Binding Key}"
                                            Click="CopyKey_Click"/>

                                    <!-- Enable/Disable butonu -->
                                    <Button Grid.Column="3"
                                            Tag="{Binding Key}"
                                            Click="ToggleLicense_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                                <Setter Property="Content" Value="✓ Aktif"/>
                                                <Setter Property="Background" Value="#1A4A2A"/>
                                                <Setter Property="Foreground" Value="#2ECC71"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Content" Value="✗ Pasif"/>
                                                        <Setter Property="Background" Value="#4A1A1A"/>
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Durum Çubuğu ── -->
            <Border Grid.Row="4" Background="#0A0A16" CornerRadius="0,0,14,14" Padding="18,8">
                <TextBlock x:Name="FooterText"
                           Text="Token ve Gist ID'yi girerek lisansları yükleyin."
                           Foreground="#333355" FontFamily="Segoe UI" FontSize="11"/>
            </Border>
        </Grid>
    </Border>
</Window>
