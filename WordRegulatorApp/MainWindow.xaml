<Window x:Class="WordRegulatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordRegulatorApp.ViewModels"
        mc:Ignorable="d"
        Title="WordRegulator - Çoklu Word Şablon &amp; Değişken Düzenleyici" 
        Height="900" Width="1320"
        MinHeight="740" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentCyanBrush}" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WordRegulator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Çoklu Word Doküman Şablon &amp; Değişken Otomasyon Uygulaması" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#20202B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Değişkenler: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TotalVariableCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#20202B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bağımsız: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding IndependentCount}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#20202B" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bağımlı: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding DependentCount}" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisConverter}}"
                        Background="#3D1414" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktif internet bağlantısı algılanamadı! Rapor oluşturmak ve sistemi kullanabilmek için internet bağlantısı zorunludur." 
                                   FontWeight="SemiBold" Foreground="#FCA5A5" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📂 Çıktı Klasörü" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Klasör Seç" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>

                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🏷️ Proje / Klasör Adı" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding OutputFolderTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Çıktıların toplanacağı alt klasör adı (örn: Proje_Çıktısı)"/>
                    </StackPanel>

                    
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="📁 Sabit Şablonlar" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Klasörü Aç" Command="{Binding OpenTemplateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="%AppData% içindeki şablon klasörünü açar"/>
                            <Button Content="Yenile" Command="{Binding RefreshTemplatesCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Şablon klasörünü yeniden tarar"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                
                <Border Grid.Row="1" Background="#13131A" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DetectedTemplateNames}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="Sabit %AppData% Sistemi" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" 
                     Margin="0,0,16,0" VerticalAlignment="Center"/>

            
            <Button Grid.Column="1" Content="Varsayılana Sıfırla" Command="{Binding ResetAllCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel>
                
                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VS30 Zemin Kayma Dalga Hızı Hesaplayıcı [Vs30 = 30 / Σ(hi / Vsi)]" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Her serim için kot ve tabaka değerlerine göre VS30 formülü ve ara adımları canlı hesaplanır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Temel Üst Kotu:" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BaseTopLevelInput, UpdateSourceTrigger=PropertyChanged}" Width="135" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Temel Üst Kotu (örn: -3,24(35,57) veya 35,57). Alttaki {{FROMTHEBASETOPLEVEL}} ile senkronizedir."/>
                            </StackPanel>

                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Serim Sayısı (Elle Girin):" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Vs30SeriesCountInput, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Vs30Series}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Vs30SeriesViewModel}">
                                    <Border Margin="0,0,0,12" Background="#14141E" CornerRadius="10" Padding="14" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                                        <StackPanel>
                                            
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SeriesName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>

                                                
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="Kot Başlangıç:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding KotStartInput, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="Kot Bitiş:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding KotEndInput, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="T0:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding T0Input, UpdateSourceTrigger=PropertyChanged}" Width="65" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Yüzeyde VS30:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding SurfaceVs30Input, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Elle girilen yüzey VS30 değeri (örn: 944,20)"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Df: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding DfDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#2E1065" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="VS30: " FontSize="11" Foreground="#C4B5FD"/>
                                                            <TextBlock Text="{Binding Vs30Result}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#1E1B4B" CornerRadius="6" Padding="10,5" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="A: " FontSize="11" Foreground="#A5F3FC"/>
                                                            <TextBlock Text="{Binding ADisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            
                                            
                                            <Border Margin="0,8,0,0" Background="#0F0F1A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Sismik Koordinatlar" FontSize="11" FontWeight="Bold" Foreground="#14B8A6" Margin="0,0,0,6"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="X Başlangıç:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding XStart, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Y Başlangıç:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding YStart, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="X Bitiş:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding XFinish, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Y Bitiş:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding YFinish, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <TextBlock Text="1. Tabaka — Poisson / Kayma / Bulk / Elastisite" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Margin="0,8,0,4"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Poisson:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding PoissonLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Kayma:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ShearModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Bulk:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding BulkModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Elastisite:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ElasticityModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <TextBlock Text="2. Tabaka — Poisson / Kayma / Bulk / Elastisite" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Margin="0,8,0,4"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Poisson:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding PoissonLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Kayma:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ShearModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Bulk:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding BulkModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Elastisite:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ElasticityModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            
                                            <ItemsControl ItemsSource="{Binding Layers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:Vs30LayerViewModel}">
                                                        <Border Width="225" Margin="0,0,10,6" CornerRadius="8" Padding="10,8" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1E1E2C"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                            <Setter Property="Background" Value="#1A0A0A"/>
                                                                            <Setter Property="BorderBrush" Value="#6B2020"/>
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding LayerName}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}"/>
                                                                    
                                                                    <Border Grid.Column="1" Background="#6B2020" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="HARIÇ" FontSize="8" FontWeight="Bold" Foreground="#FF6B6B"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="4"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="4"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Alt (m):" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding StartDepthInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Üst (m):" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding EndDepthInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="4">
                                                                        <TextBlock Text="Vs (m/s):" FontSize="9" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                                                                        <TextBox Text="{Binding VelocityInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- İkinci Tabaka Seti (Vs Ort. Tablosu için - LAYER_VSUR) -->
                                            <Border Margin="0,10,0,0" Background="#0A1A1A" CornerRadius="8" Padding="10,8" BorderBrush="#0D9488" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="📊 " FontSize="12"/>
                                                        <TextBlock Text="Vs Ortalama Tablosu İçin Tabaka Seti 2" FontSize="11" FontWeight="Bold" Foreground="#14B8A6"/>
                                                        <TextBlock Text=" ({{LAYER_VSUR}} → 2. tablo)" FontSize="10" Foreground="#5EEAD4" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                                            <TextBlock Text="Tabaka Sayısı:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <ComboBox ItemsSource="{Binding LayerCountOptions2}" SelectedItem="{Binding SelectedLayerCount2}" Width="55" Height="22" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Layers2}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:Vs30LayerViewModel}">
