                                <TextBlock Text="Birden fazla seçebilirsiniz. Seçimleriniz {{FORMATİONTYPE}} ve {{FORMATİONTEXT}} değişkenlerine otomatik yansır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Formations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,8" Cursor="Hand"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Ayırıcı Çizgi -->
                        <Border Height="1" Background="#22333B" Margin="0,14,0,14"/>

                        <!-- Yerleşime Uygunluk (RESİDENTİALSUİTABİLİTY) Bölümü -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,16,0" Width="260">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#3B82F6" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="🏘️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Yerleşime Uygunluk:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Seçiminiz {{RESİDENTİALSUİTABİLİTY}} değişkenine otomatik yansır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ResidentialSuitabilities}"
                                          SelectedItem="{Binding SelectedResidentialSuitability}"
                                          DisplayMemberPath="Name"
                                          Height="34"
                                          FontSize="12"
                                          Padding="8,5"
                                          Background="White"
                                          Foreground="Black"
                                          BorderBrush="{StaticResource BorderDarkBrush}"
                                          Cursor="Hand"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Center">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <TextBlock Text="{Binding SelectedResidentialSuitability.Description}"
                                           Margin="4,6,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           MaxHeight="38"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                
                <ItemsControl ItemsSource="{Binding FilteredVariablesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VariableItemViewModel}">
                            
                            <Border Width="385" Margin="0,0,12,12" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                        
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDependent}" Value="False">
                                                            <Setter Property="Background" Value="#164E63"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                            <Setter Property="Background" Value="#4C1D95"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDependent}" Value="False">
                                                                <Setter Property="Text" Value="BAĞIMSIZ"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                                <Setter Property="Text" Value="BAĞIMLI (KİLİTLİ)"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#13131A" CornerRadius="4" Padding="5,2" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Key, StringFormat='\{\{\{0\}\}\}'}" FontSize="11" FontFamily="Consolas, Courier New" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    
                                    <TextBox Grid.Row="2" 
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsEnabled}" 
                                             IsReadOnly="{Binding IsReadOnly}" 
                                             Style="{StaticResource DarkTextBoxStyle}"/>

                                    
                                    <Grid Grid.Row="3" Margin="0,4,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="🔒 Bağımlı değişken (Otomatik hesaplanır)." FontSize="10" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        
        <Border Grid.Row="4" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRoseBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Info">
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                
                <Button Grid.Column="1" 
                        Content="Oluştur (Tüm Şablonları İşle)" 
                        Command="{Binding GenerateDocumentCommand}" 
                        Style="{StaticResource GenerateButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
