<Window x:Class="WordRegulatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordRegulatorApp.ViewModels"
        mc:Ignorable="d"
        Title="WordRegulator - Çoklu Word Şablon &amp; Değişken Düzenleyici" 
        Height="900" Width="1320"
        MinHeight="740" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Section -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Folder Toolbar & Detected Templates -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Search Bar & Actions -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Variables & Interactive Calculation Panels (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- 4: Bottom Action & Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER SECTION -->
        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCyanBrush}" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WordRegulator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Çoklu Word Doküman Şablon &amp; Değişken Otomasyon Uygulaması" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Stats Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#20202B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Değişkenler: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TotalVariableCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20202B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bağımsız: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding IndependentCount}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20202B" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bağımlı: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding DependentCount}" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. FOLDER TOOLBAR & DETECTED TEMPLATES -->
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Template Directory Selector -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📁 Word Şablon Klasörü" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TemplateDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Klasör Seç" Command="{Binding BrowseTemplateDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="Aç" Command="{Binding OpenTemplateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Output Directory Selector -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="📂 Ana Çıktı Klasörü" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Klasör Seç" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Output Subfolder Title Selector -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="🏷️ Proje / Klasör Adı" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding OutputFolderTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Çıktıların toplanacağı özel alt klasör adı (örn: denemeciktisi)"/>
                    </StackPanel>
                </Grid>

                <!-- Detected Template Files Info Banner -->
                <Border Grid.Row="1" Background="#13131A" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DetectedTemplateNames}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="Otomatik Tarama" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. SEARCH BAR & ACTIONS -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Field -->
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" 
                     Margin="0,0,16,0" VerticalAlignment="Center"/>

            <!-- Reset Button -->
            <Button Grid.Column="1" Content="Varsayılana Sıfırla" Command="{Binding ResetAllCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 3. MAIN VARIABLES & CALCULATORS SCROLLABLE CONTAINER -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel>
                <!-- ================= ⚡ VS30 JEOFİZİK HESAPLAMA PANELİ ================= -->
                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Başlığı & Üst Kontroller -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VS30 Zemin Kayma Dalga Hızı Hesaplayıcı [Vs30 = 30 / Σ(hi / Vsi)]" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Her serim için kot ve tabaka değerlerine göre VS30 formülü ve ara adımları canlı hesaplanır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Temel Üst Kotu Girişi -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Temel Üst Kotu:" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BaseTopLevelInput, UpdateSourceTrigger=PropertyChanged}" Width="135" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Temel Üst Kotu (örn: -3,24(35,57) veya 35,57). Alttaki {{FROMTHEBASETOPLEVEL}} ile senkronizedir."/>
                            </StackPanel>

                            <!-- Serim Sayısı Elle Giriş -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Serim Sayısı (Elle Girin):" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Vs30SeriesCountInput, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Serim Listesi (Her Serim Kendi Kot ve Tabaka Tablosunu İçerir) -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Vs30Series}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Vs30SeriesViewModel}">
                                    <Border Margin="0,0,0,12" Background="#14141E" CornerRadius="10" Padding="14" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Serim Üst Başlık & Kot Girdileri & Canlı Sonuçlar -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Serim Başlığı -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SeriesName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Kot Başlangıç & Kot Bitiş -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="Kot Başlangıç:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding KotStartInput, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="Kot Bitiş:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding KotEndInput, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <TextBlock Text="T0:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding T0Input, UpdateSourceTrigger=PropertyChanged}" Width="65" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Yüzeyde VS30:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding SurfaceVs30Input, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28" Padding="6,4" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Elle girilen yüzey VS30 değeri (örn: 944,20)"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Canlı Sonuç Badgeleri: Df, VS30 & A -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Df: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding DfDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#2E1065" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="VS30: " FontSize="11" Foreground="#C4B5FD"/>
                                                            <TextBlock Text="{Binding Vs30Result}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#1E1B4B" CornerRadius="6" Padding="10,5" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="A: " FontSize="11" Foreground="#A5F3FC"/>
                                                            <TextBlock Text="{Binding ADisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tabaka Tablosu (Bu Serim İçin) -->
                                            <!-- Sismik Koordinatlar & Modüller -->
                                            <Border Margin="0,8,0,0" Background="#0F0F1A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Sismik Koordinatlar" FontSize="11" FontWeight="Bold" Foreground="#14B8A6" Margin="0,0,0,6"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="X Başlangıç:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding XStart, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Y Başlangıç:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding YStart, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="X Bitiş:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding XFinish, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Y Bitiş:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding YFinish, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <TextBlock Text="1. Tabaka — Poisson / Kayma / Bulk / Elastisite" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Margin="0,8,0,4"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Poisson:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding PoissonLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Kayma:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ShearModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Bulk:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding BulkModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Elastisite:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ElasticityModulusLayer1, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <TextBlock Text="2. Tabaka — Poisson / Kayma / Bulk / Elastisite" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Margin="0,8,0,4"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Poisson:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding PoissonLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Kayma:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ShearModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <TextBlock Text="Bulk:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding BulkModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="Elastisite:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ElasticityModulusLayer2, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="24" Padding="4,2" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tabaka Tablosu (Bu Serim İçin) -->
                                            <ItemsControl ItemsSource="{Binding Layers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:Vs30LayerViewModel}">
                                                        <Border Width="225" Margin="0,0,10,6" CornerRadius="8" Padding="10,8" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1E1E2C"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                            <Setter Property="Background" Value="#1A0A0A"/>
                                                                            <Setter Property="BorderBrush" Value="#6B2020"/>
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding LayerName}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}"/>
                                                                    <!-- Excluded badge -->
                                                                    <Border Grid.Column="1" Background="#6B2020" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="HARIÇ" FontSize="8" FontWeight="Bold" Foreground="#FF6B6B"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="4"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="4"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Alt (m):" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding StartDepthInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Üst (m):" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding EndDepthInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="4">
                                                                        <TextBlock Text="Vs (m/s):" FontSize="9" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                                                                        <TextBox Text="{Binding VelocityInput, UpdateSourceTrigger=PropertyChanged}" Height="26" Padding="4,2" FontSize="11" Style="{StaticResource DarkTextBoxStyle}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ================= 🏗️ SONDAJ KUYULARI İNTERAKTİF YÖNETİM PANENİ ================= -->
                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Başlığı & Kuyu Sayısı Elle Giriş Kutusı -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentCyanBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="⛏️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sondaj Kuyuları ve Metraj Yönetimi (Dinamik Kuyu Girişi)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Kuyu sayısını elle girebilirsiniz. Girilen sayıya göre otomatik detay alanları açılır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sondaj Kuyusu Sayısı ELLE GİRİŞ KUTUSU -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sondaj Kuyusu Sayısı (Elle Girin):" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DrillingWellCountInput, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dinamik Sondaj Kuyu Kartları -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DrillingWells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DrillingWellViewModel}">
                                    <Border Width="385" Margin="0,0,12,12" Background="#1A1A24" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Kuyu Başlığı -->
                                            <Border Background="#20202B" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding WellName, StringFormat='📌 {0} Kuyusu Detayları'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>

                                            <!-- Enlem & Boylam -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Enlem:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Boylam:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Arazi Kotu & Sondaj Dip Kotu & Metre -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Arazi Kotu:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding GroundKot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Dip Kotu:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding BottomKot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Derinlik (m):" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding DepthInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tarihler: Başlangıç & Bitiş -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Başlangıç Tarihi:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Bitiş Tarihi:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding FinishDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Sonuç & Presiyometre Deneyi & Kuyu Çökmesi CheckBox -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Açıklama / Sonuç:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <!-- Presiyometre Deneyi -->
                                                <CheckBox Grid.Column="1" Content="Presiyometre Deneyi" IsChecked="{Binding HasPressuremeterTest, UpdateSourceTrigger=PropertyChanged}" Foreground="#A5F3FC" FontSize="10" VerticalAlignment="Center" Cursor="Hand"/>
                                                <!-- Kuyu Çökmesi -->
                                                <CheckBox Grid.Column="3" Content="Kuyu Çökmesi" IsChecked="{Binding IsCollapsed, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Cursor="Hand"/>
                                            </Grid>
                                            <TextBox Text="{Binding GroundwaterStatus, UpdateSourceTrigger=PropertyChanged}" 
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="0,0,0,8">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
                                                        <Setter Property="MinHeight" Value="34"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter Property="MinHeight" Value="80"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                             <!-- Presiyometre Deneyi Veri Giriş Paneli -->
                                             <Border Margin="0,2,0,8">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding HasPressuremeterTest}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <Border Background="#0D1B2A" CornerRadius="8" Padding="10,8" BorderBrush="#2A6496" BorderThickness="1">
                                                     <StackPanel>
                                                         <!-- Başlık + Ekle/Sil Butonları -->
                                                         <Grid Margin="0,0,0,6">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="6"/>
                                                                 <ColumnDefinition Width="Auto"/>
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Grid.Column="0" Text="🔬 Presiyometre Deneyi Sonuçları" FontSize="11" FontWeight="Bold" Foreground="#A5F3FC" VerticalAlignment="Center"/>
                                                             <Button Grid.Column="1" Content="+ Satır" Command="{Binding AddPressuremeterRowCommand}" Height="22" Padding="8,0" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                                                 <Button.Style>
                                                                     <Style TargetType="Button">
                                                                         <Setter Property="Background" Value="#1A3A5C"/>
                                                                         <Setter Property="Foreground" Value="#A5F3FC"/>
                                                                         <Setter Property="BorderBrush" Value="#2A6496"/>
                                                                         <Setter Property="BorderThickness" Value="1"/>
                                                                         <Setter Property="Template">
                                                                             <Setter.Value>
                                                                                 <ControlTemplate TargetType="Button">
                                                                                     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                     </Border>
                                                                                 </ControlTemplate>
                                                                             </Setter.Value>
                                                                         </Setter>
                                                                         <Style.Triggers>
                                                                             <Trigger Property="IsMouseOver" Value="True">
                                                                                 <Setter Property="Background" Value="#245080"/>
                                                                             </Trigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Button.Style>
                                                             </Button>
                                                             <Button Grid.Column="3" Content="− Satır" Command="{Binding RemovePressuremeterRowCommand}" Height="22" Padding="8,0" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                                                 <Button.Style>
                                                                     <Style TargetType="Button">
                                                                         <Setter Property="Background" Value="#3A1A1A"/>
                                                                         <Setter Property="Foreground" Value="#FCA5A5"/>
                                                                         <Setter Property="BorderBrush" Value="#7B2020"/>
                                                                         <Setter Property="BorderThickness" Value="1"/>
                                                                         <Setter Property="Template">
                                                                             <Setter.Value>
                                                                                 <ControlTemplate TargetType="Button">
                                                                                     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                     </Border>
                                                                                 </ControlTemplate>
                                                                             </Setter.Value>
                                                                         </Setter>
                                                                         <Style.Triggers>
                                                                             <Trigger Property="IsMouseOver" Value="True">
                                                                                 <Setter Property="Background" Value="#5A2020"/>
                                                                             </Trigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Button.Style>
                                                             </Button>
                                                         </Grid>

                                                         <!-- Sütun Başlıkları -->
                                                         <Grid Margin="0,0,0,4">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="5"/>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="5"/>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="5"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Grid.Column="0" Text="Derinlik (m)" FontSize="9" Foreground="#64B5F6" FontWeight="Bold"/>
                                                             <TextBlock Grid.Column="2" Text="PL (kg/cm²)" FontSize="9" Foreground="#64B5F6" FontWeight="Bold"/>
                                                             <TextBlock Grid.Column="4" Text="PL* (kg/cm²)" FontSize="9" Foreground="#64B5F6" FontWeight="Bold"/>
                                                             <TextBlock Grid.Column="6" Text="Em (kg/cm²)" FontSize="9" Foreground="#64B5F6" FontWeight="Bold"/>
                                                         </Grid>

                                                         <!-- Satır Listesi -->
                                                         <ItemsControl ItemsSource="{Binding PressuremeterRows}">
                                                             <ItemsControl.ItemTemplate>
                                                                 <DataTemplate DataType="{x:Type vm:PressuremeterRowViewModel}">
                                                                     <Grid Margin="0,0,0,4">
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="*"/>
                                                                             <ColumnDefinition Width="5"/>
                                                                             <ColumnDefinition Width="*"/>
                                                                             <ColumnDefinition Width="5"/>
                                                                             <ColumnDefinition Width="*"/>
                                                                             <ColumnDefinition Width="5"/>
                                                                             <ColumnDefinition Width="*"/>
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBox Grid.Column="0" Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="24" Padding="4,2" FontSize="11"/>
                                                                         <TextBox Grid.Column="2" Text="{Binding LimitPressure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="24" Padding="4,2" FontSize="11"/>
                                                                         <TextBox Grid.Column="4" Text="{Binding NetLimitPressure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="24" Padding="4,2" FontSize="11"/>
                                                                         <TextBox Grid.Column="6" Text="{Binding ElasticityModulus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="24" Padding="4,2" FontSize="11"/>
                                                                     </Grid>
                                                                 </DataTemplate>
                                                             </ItemsControl.ItemTemplate>
                                                         </ItemsControl>
                                                     </StackPanel>
                                                 </Border>
                                             </Border>

                                            <!-- Yeraltı Suyu Ölçümleri -->
                                            <Border Background="#20202B" CornerRadius="6" Padding="8,4" Margin="0,2,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💧 Yeraltı Suyu Ölçümleri" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Ölçüm Sayısı:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ComboBox ItemsSource="{Binding MeasurementCountOptions}" SelectedItem="{Binding SelectedMeasurementCount, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11" Height="22"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Ölçüm Listesi (Dinamik) -->
                                            <ItemsControl ItemsSource="{Binding Measurements}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GroundwaterMeasurementViewModel}">
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Index, StringFormat='Ölçüm {0} Tarihi:'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding MeasurementDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Yeraltı Suyu (m.):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding WaterDepth, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ================= 📡 MİKROTREMÖR ÖLÇÜMÜ ================= -->
                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#F59E0B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Başlığı & Ölçüm Sayısı -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F59E0B" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="📡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mikrotremör Ölçümü (Dinamik Ölçüm Girişi)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Ölçüm sayısını girin. Her ölçüm için Tablo 1 (T0/Ta/Tb/Frekans) ve Tablo 2 (Tarih/Koordinat) alanları açılır." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Mikrotremör Ölçüm Sayısı -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ölçüm Sayısı (Elle Girin):" FontSize="12" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding MicrotremorCountInput, UpdateSourceTrigger=PropertyChanged}" Width="65" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ölçüm Kartları -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MicrotremorMeasurements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MicrotremorMeasurementViewModel}">
                                    <Border Width="430" Margin="0,0,12,12" Background="#1A1A24" CornerRadius="10" Padding="12" BorderBrush="#92400E" BorderThickness="1">
                                        <StackPanel>

                                            <!-- Ölçüm Başlığı -->
                                            <Border Background="#20202B" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding DisplayName, StringFormat='📡 {0}'}" FontWeight="Bold" FontSize="12" Foreground="#F59E0B"/>
                                            </Border>

                                            <!-- TABLO 1: Ölçüm Veri Tablosu Başlığı -->
                                            <Border Background="#1A1200" CornerRadius="6" Padding="8,4" Margin="0,0,0,6" BorderBrush="#78350F" BorderThickness="1">
                                                <TextBlock Text="Tablo 1 — Ölçüm Verileri: Ölçü No / T0 / Ta / Tb / Frekans" FontSize="10" FontWeight="Bold" Foreground="#FCD34D"/>
                                            </Border>

                                            <!-- TABLO 1 Grid: T0, Ta, Tb, Frekans -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- T0 -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="T0 (sn):" FontSize="10" Foreground="#F59E0B" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding T0, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_T0 — Hakim periyot değeri (sn)"/>
                                                </StackPanel>

                                                <!-- Ta -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Ta:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding Ta, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_TA — Alt periyot değeri"/>
                                                </StackPanel>

                                                <!-- Tb -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Tb:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding Tb, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_TB — Üst periyot değeri"/>
                                                </StackPanel>

                                                <!-- Frekans -->
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="Frekans (Hz):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_FREQ — Frekans değeri (Hz)"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- TABLO 2: Konum Tablosu Başlığı -->
                                            <Border Background="#111A12" CornerRadius="6" Padding="8,4" Margin="0,0,0,6" BorderBrush="#166534" BorderThickness="1">
                                                <TextBlock Text="Tablo 2 — Konum Bilgileri: Ölçüm No / Tarih / Yatay Koordinat / Düşey Koordinat" FontSize="10" FontWeight="Bold" Foreground="#86EFAC"/>
                                            </Border>

                                            <!-- TABLO 2 Grid: Tarih, Yatay, Düşey -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tarih -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Tarih:" FontSize="10" Foreground="#86EFAC" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_DATE veya MT_[N]_TARIH — Ölçüm tarihi"/>
                                                </StackPanel>

                                                <!-- Yatay Koordinat -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Yatay Koor. (X):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding HorizontalCoordinate, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_X veya MT_[N]_YATAY — Yatay koordinat"/>
                                                </StackPanel>

                                                <!-- Düşey Koordinat -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Düşey Koor. (Y):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBox Text="{Binding VerticalCoordinate, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,4" Style="{StaticResource DarkTextBoxStyle}"
                                                             ToolTip="Raporda: MT_[N]_Y veya MT_[N]_DUZEY — Düşey koordinat"/>
                                                </StackPanel>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ================= 🌍 FORMASYON SEÇİMİ ================= -->
                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#14B8A6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Background="#14B8A6" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                <TextBlock Text="🌍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Formasyon Tipi:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding FormationList}" 
                                  SelectedItem="{Binding SelectedFormation}"
                                  DisplayMemberPath="Name"
                                  Height="32" 
                                  VerticalContentAlignment="Center"
                                  ToolTip="Formasyon tipini seçtiğinizde rapordaki {{FORMATİONTYPE}} ve {{FORMATİONTEXT}} değişkenleri otomatik olarak dolacaktır."/>
                    </Grid>
                </Border>

                <!-- ================= 📝 GENEL DEĞİŞKENLER İNPUT GRID ================= -->
                <ItemsControl ItemsSource="{Binding FilteredVariablesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VariableItemViewModel}">
                            <!-- Variable Input Card -->
                            <Border Width="385" Margin="0,0,12,12" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Title + Type Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                        <!-- Badge for Type -->
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDependent}" Value="False">
                                                            <Setter Property="Background" Value="#164E63"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                            <Setter Property="Background" Value="#4C1D95"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDependent}" Value="False">
                                                                <Setter Property="Text" Value="BAĞIMSIZ"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                                <Setter Property="Text" Value="BAĞIMLI (KİLİTLİ)"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Placeholder Key Tag -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#13131A" CornerRadius="4" Padding="5,2" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Key, StringFormat='\{\{\{0\}\}\}'}" FontSize="11" FontFamily="Consolas, Courier New" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Input Box (Disabled / ReadOnly for Dependent variables) -->
                                    <TextBox Grid.Row="2" 
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsEnabled}" 
                                             IsReadOnly="{Binding IsReadOnly}" 
                                             Style="{StaticResource DarkTextBoxStyle}"/>

                                    <!-- Sub-info for Dependent variables -->
                                    <Grid Grid.Row="3" Margin="0,4,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDependent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="🔒 Bağımlı değişken (Otomatik hesaplanır)." FontSize="10" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. BOTTOM ACTION & STATUS FOOTER -->
        <Border Grid.Row="4" Background="{StaticResource PanelDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message Banner -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRoseBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessageType}" Value="Info">
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- FLOATING GENERATE BUTTON FIXED AT BOTTOM RIGHT -->
                <Button Grid.Column="1" 
                        Content="Oluştur (Tüm Şablonları İşle)" 
                        Command="{Binding GenerateDocumentCommand}" 
                        Style="{StaticResource GenerateButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
